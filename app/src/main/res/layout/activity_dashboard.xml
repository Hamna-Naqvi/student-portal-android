<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Student Dashboard"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:background="#DCE8FF"
            android:text="📚\nCourses"
            android:textSize="20sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:background="#DDF5E3"
            android:text="📝\nAssignments"
            android:textSize="20sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:background="#FFF0D5"
            android:text="🏆\nResults"
            android:textSize="20sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:background="#F8DFF0"
            android:text="📢\nAnnouncements"
            android:textSize="20sp"/>

    </GridLayout>

    <Button
        android:id="@+id/btnProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Profile"
        android:layout_marginTop="24dp"/>

</LinearLayout>
